#!/usr/bin/bash
# Charge Limit backend. Reads and writes kernel charge thresholds.
# Does not touch power-profiles-daemon.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/smart-charge"
HELPER=/usr/local/sbin/set-battery-charge-thresholds
POWER_SUPPLY=/sys/class/power_supply
CONSERVE_END=${CHARGE_CONSERVE_END:-80}

is_pct() { [[ ${1:-} =~ ^[0-9]+$ ]] && ((10#$1 >= 0 && 10#$1 <= 100)); }

if ! is_pct "$CONSERVE_END"; then
  CONSERVE_END=80
fi
if ((10#$CONSERVE_END < 50)); then CONSERVE_END=50; fi
if ((10#$CONSERVE_END > 95)); then CONSERVE_END=95; fi

CONSERVE_START=$((10#$CONSERVE_END - 5))
FULL_END=100

ensure_state_dir() {
  local dir=$1 owner
  /usr/bin/mkdir -p -m 700 -- "$dir"
  if [[ -L $dir || ! -d $dir ]]; then
    echo "Refusing state directory $dir" >&2
    return 1
  fi
  owner=$(/usr/bin/stat -c '%u' -- "$dir")
  if [[ $owner != "$EUID" ]]; then
    echo "Refusing state directory $dir" >&2
    return 1
  fi
  /usr/bin/chmod 700 -- "$dir"
}

read_file() {
  local path=$1 out
  [[ -n ${path:-} ]] || { printf ''; return 0; }
  out=$(/usr/bin/dd if="$path" iflag=nofollow,nonblock,count_bytes,fullblock bs=1 count=65 status=none 2>/dev/null || true)
  printf '%s' "${out//$'\n'/}"
}

write_state() {
  local dest=$1 payload=$2 dir t
  dir=${dest%/*}
  ensure_state_dir "$dir" || return 1
  umask 077
  t=$(/usr/bin/mktemp -p "$dir" .state.XXXXXXXXXX) || return 1
  if ! printf '%s\n' "$payload" >"$t"; then
    /usr/bin/rm -f -- "$t"
    return 1
  fi
  if ! /usr/bin/mv -f -T -- "$t" "$dest"; then
    /usr/bin/rm -f -- "$t"
    return 1
  fi
}

find_battery() {
  local d
  for d in "$POWER_SUPPLY"/*; do
    [[ -e $d/charge_control_end_threshold ]] || continue
    printf '%s\n' "$d"
    return 0
  done
  printf ''
}

is_ac() {
  local d
  for d in "$POWER_SUPPLY"/*; do
    [[ $(read_file "$d/type") == Mains ]] || continue
    [[ $(read_file "$d/online") == 1 ]] && return 0
  done
  return 1
}

current_mode() {
  read_file "$STATE_DIR/mode"
}

set_mode() {
  case "$1" in
    full | conserve) ;;
    *) return 1 ;;
  esac
  [[ $(current_mode) == "$1" ]] && return 0
  write_state "$STATE_DIR/mode" "$1"
}


battery_name() {
  local name
  name=${1##*/}
  if [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]]; then
    printf '%s' "$name"
  fi
}

write_thresholds() {
  local start=$1 end=$2 bat=$3
  if [[ -x $HELPER ]]; then
    if /usr/bin/sudo -n "$HELPER" "$start" "$end" 2>/dev/null; then
      return 0
    fi
  fi
  if [[ -n $bat && -w $bat/charge_control_start_threshold && -w $bat/charge_control_end_threshold ]]; then
    if ((10#$end >= 10#$(read_file "$bat/charge_control_end_threshold"))); then
      printf '%s\n' "$end" >"$bat/charge_control_end_threshold"
      printf '%s\n' "$start" >"$bat/charge_control_start_threshold"
    else
      printf '%s\n' "$start" >"$bat/charge_control_start_threshold"
      printf '%s\n' "$end" >"$bat/charge_control_end_threshold"
    fi
    return 0
  fi
  echo "Charge thresholds are not writable. Run scripts/install-helper once with sudo." >&2
  return 1
}

cmd_status() {
  local bat start end cap mode writable ac json=0 name charge_state
  [[ ${1:-} == --json ]] && json=1
  bat=$(find_battery)
  if [[ -z $bat ]]; then
    if ((json)); then
      printf '{"supported":false,"writable":false,"ac":false,"capacity":0,"start":0,"end":0,"mode":"unknown","battery":"","error":"unsupported"}\n'
    else
      echo "Charge thresholds are not supported on this machine."
    fi
    return 0
  fi
  start=$(read_file "$bat/charge_control_start_threshold")
  end=$(read_file "$bat/charge_control_end_threshold")
  cap=$(read_file "$bat/capacity")
  charge_state=$(read_file "$bat/status")
  case "$charge_state" in
    Charging | Discharging | Full | "Not charging") ;;
    *) charge_state=Unknown ;;
  esac
  is_pct "$start" || start=0
  is_pct "$end" || end=0
  is_pct "$cap" || cap=0
  if [[ $end == 100 ]]; then mode=full; else mode=conserve; fi
  writable=false
  if [[ -w $bat/charge_control_end_threshold ]]; then
    writable=true
  elif [[ -x $HELPER ]]; then
    writable=true
  fi
  ac=false
  is_ac && ac=true
  name=$(battery_name "$bat")
  if ((json)); then
    printf '{"supported":true,"writable":%s,"ac":%s,"capacity":%s,"start":%s,"end":%s,"mode":"%s","battery":"%s","chargeState":"%s","error":""}\n' \
      "$writable" "$ac" "$cap" "$start" "$end" "$mode" "$name" "$charge_state"
  else
    echo "Supported:     yes"
    echo "Writable:      $writable"
    echo "AC:            $([[ $ac == true ]] && echo online || echo offline)"
    echo "Capacity:      ${cap}%"
    echo "Charge state:  $charge_state"
    echo "Thresholds:    ${start}–${end}%"
    echo "Mode:          $mode"
    echo "Battery:       $name"
  fi
}

apply_conserve() {
  local bat
  bat=$(find_battery)
  [[ -n $bat ]] || { echo "No threshold-capable battery." >&2; return 1; }
  if [[ $(read_file "$bat/charge_control_start_threshold") != "$CONSERVE_START" ||
        $(read_file "$bat/charge_control_end_threshold") != "$CONSERVE_END" ]]; then
    write_thresholds "$CONSERVE_START" "$CONSERVE_END" "$bat"
  fi
  set_mode conserve
}

apply_full() {
  local bat
  bat=$(find_battery)
  [[ -n $bat ]] || { echo "No threshold-capable battery." >&2; return 1; }
  is_ac || { echo "Plug in AC before choosing 100%." >&2; return 1; }
  # A high start threshold starts charging from the conservation band and
  # lets the firmware top up again while the full-charge profile is selected.
  write_thresholds 99 "$FULL_END" "$bat"
  set_mode full
  # Unplugging during the privileged write must not leave a full-charge cap.
  if ! is_ac; then apply_conserve; fi
}

cmd_tick() {
  local bat
  bat=$(find_battery)
  [[ -n $bat ]] || return 0
  if ! is_ac; then
    apply_conserve
  elif [[ $(current_mode) != full || $(read_file "$bat/charge_control_end_threshold") != 100 ]]; then
    apply_conserve
  fi
}

main() {
  local cmd=${1:-status}
  case "$cmd" in
    status) cmd_status "${2:-}"; return ;;
    -h | --help | help)
      echo "Usage: charge-ctl [status [--json]|conserve|full|tick]"
      echo "Full charge stays selected until unplugged. Conservation defaults to 75–80%."
      return ;;
    tick | conserve | full | travel) ;;
    *) echo "Unknown command: $cmd" >&2; return 1 ;;
  esac
  ensure_state_dir "$STATE_DIR"
  exec 9>"$STATE_DIR/lock"
  /usr/bin/flock -w 5 9
  case "$cmd" in
    tick) cmd_tick ;;
    conserve) apply_conserve ;;
    full | travel) apply_full ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
